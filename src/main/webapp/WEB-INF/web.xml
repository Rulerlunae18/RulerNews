<!DOCTYPE web-app PUBLIC
        "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
        "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <servlet>
        <servlet-name>HelloServlet</servlet-name>
        <servlet-class>com.example.servlets.HelloServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HelloServlet</servlet-name>
        <url-pattern>/Hello</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>com.example.servlets.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/Home</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.example.servlets.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/Register</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>GuestLoginServlet</servlet-name>
        <servlet-class>com.example.servlets.GuestLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GuestLoginServlet</servlet-name>
        <url-pattern>/GuestLogin</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.example.servlets.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/Login</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>RateNewsServlet</servlet-name>
        <servlet-class>com.example.servlets.RateNewsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RateNewsServlet</servlet-name>
        <url-pattern>/RateNews</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>DeleteNewsServlet</servlet-name>
        <servlet-class>com.example.servlets.RateNewsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeleteNewsServlet</servlet-name>
        <url-pattern>/DeleteNews</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>ConfirmEmailServlet</servlet-name>
        <servlet-class>com.example.servlets.ConfirmEmailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ConfirmEmailServlet</servlet-name>
        <url-pattern>/ConfirmEmail</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>ResendConfirmationServlet</servlet-name>
        <servlet-class>com.example.servlets.ResendConfirmationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResendConfirmationServlet</servlet-name>
        <url-pattern>/ResendConfirmation</url-pattern>
    </servlet-mapping>
</web-app>